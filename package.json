{
  "name": "bun-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preview:ui": "bun tools/preview-ui.js",
    "test:ui": "node tools/review-ui.mjs",
    "audit:site": "node tools/audit-site.mjs",
    "test:site:browser": "node tests/test_site_ui_browser.mjs",
    "test:site:refresh": "node tests/test_site_refresh_browser.mjs",
    "test:leaderboard": "node tests/test_leaderboard_ui.mjs",
    "start": "cargo run --release --manifest-path rust/Cargo.toml -p mitch-server",
    "start:wrapper": "bun server.js",
    "test": "cargo test --manifest-path rust/Cargo.toml --workspace",
    "test:unit": "cargo test --manifest-path rust/Cargo.toml --workspace",
    "test:admin:browser": "node tests/test_admin_modernization.mjs",
    "test:service-worker": "node tests/test_service_worker_unit.js"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.1",
    "dotenv": "^17.4.2",
    "googleapis": "^171.4.0",
    "imapflow": "^1.3.2",
    "nodemailer": "^10.2.1",
    "ssh2": "^1.17.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "ws": "^8.22.0"
  }
}
