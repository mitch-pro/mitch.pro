:6800 {
    # Resolve client IP: X-Mitch-Client-IP (from trusted upstream Nginx) -> X-Real-IP -> immediate peer
    map {header.X-Mitch-Client-IP} {nginx_ip} {
        ""      {header.X-Real-IP}
        default {header.X-Mitch-Client-IP}
    }
    map {nginx_ip} {real_ip} {
        ""      {header.CF-Connecting-IP}
        default {nginx_ip}
    }
    map {real_ip} {mitch_client_ip} {
        ""      {remote_host}
        default {real_ip}
    }

    reverse_proxy webserver-blue:6800 {
        header_up X-Mitch-Client-IP {mitch_client_ip}
        header_up X-Real-IP {mitch_client_ip}
        header_up X-Forwarded-For {mitch_client_ip}
        header_up CF-Connecting-IP {mitch_client_ip}
    }

    # Rotating URL aliases (/<uuid>/<uuid>/...) hide the real path from Caddy.
    # The app sets these headers itself for them (src/alias.rs), based on the
    # real path, so they are left out here.
    @not_game_content {
        not path /proxy/* /prox/* /games/*
        not path_regexp alias_prefix ^/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(/|$)
    }
    @alias_paths {
        path_regexp alias_paths ^/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(/|$)
    }
    header @alias_paths -Server
    header @not_game_content {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options SAMEORIGIN
        Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: data: https://fonts.googleapis.com https://cdnjs.cloudflare.com https://www.google.com https://www.gstatic.com https://www.recaptcha.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' blob: data: https: wss: ws:; worker-src 'self' blob: data:; frame-src 'self' blob: data: https://www.google.com https://www.recaptcha.net https://html5.gamemonetize.co https://html5.gamemonetize.com https://lumassets.pages.dev https://calculated2.github.io https://jellyfin.mitchdog.com https://*.mitchdog.com https://cinesrc.st"
        -Server
    }

    @game_content {
        path /proxy/* /prox/* /games/*
    }
    header @game_content {
        X-Content-Type-Options nosniff
        Access-Control-Allow-Origin *
        -Server
    }
}
