# Copy to Doppler / local .env — never commit real values.
PORT=6800
NODE_ENV=production
SESSION_COOKIE_SECURE=1
DATA_DIR=./data

# Mail / notifications
SUPPORT_USER=
SUPPORT_PASS=
NOREPLY_USER=
NOREPLY_PASS=
MAIL_SMTP_HOST=
MAIL_IMAP_HOST=
SUPPORT_EMAIL=
NTFY_TOPIC=
NTFY_USER=
NTFY_PASS=
GMAIL_USER=
GMAIL_PASS=
GMAIL_USER_ALT=
GMAIL_PASS_ALT=

# Auth / captcha / push
SECRET_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SMS_WEBHOOK_SECRET=

# AI
GEMINI_API_KEY=
GROQ_API_KEY=

# Feature flags (keep off in production unless intentional)
ENABLE_ADMIN_KEY_HEADER=0
ENABLE_CLIENT_CHESS_REWARDS=0
APP_DEBUG_LOGS=0

# VM Feature Configuration
HIDE_VM_FEATURES=0
PVE_LXC_TEMPLATE=local:vztmpl/debian-12-standard_12.12-1_amd64.tar.zst
PROXMOX_HOST=192.168.100.1
PROXMOX_PORT=8006
PROXMOX_NODE=tartarus
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_VERIFY_TLS=true
PROXMOX_TLS_SERVERNAME=mitch.pro
PROXMOX_DESKTOP_TEMPLATES=9010

# Internal services
BLOOKET_BOT_HOST=blooket-bot
SSH_GATEWAY_URL=ws://ssh-gateway:6820

# Analytics (optional)
GOOGLE_ANALYTICS_ID=
