# Copy to Doppler / local .env — never commit real values.
PORT=6800
NODE_ENV=production
SESSION_COOKIE_SECURE=1
DATA_DIR=./data

# Mail / notifications
SUPPORT_USER=
SUPPORT_PASS=
NOREPLY_USER=
NOREPLY_PASS=
MAIL_SMTP_HOST=
MAIL_IMAP_HOST=
SUPPORT_EMAIL=
NTFY_TOPIC=
NTFY_USER=
NTFY_PASS=
GMAIL_USER=
GMAIL_PASS=
GMAIL_USER_ALT=
GMAIL_PASS_ALT=

# Auth / captcha / push
SECRET_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SMS_WEBHOOK_SECRET=

# AI
GEMINI_API_KEY=
GROQ_API_KEY=

# Matrix chat GIF search. Optional — unset falls back to a shared public
# demo key with tight rate limits, so set this for real usage.
# https://developers.giphy.com/dashboard/ (free, choose "API" not "SDK").
GIPHY_API_KEY=

# TURN relay fallback for Matrix voice/video calls (LiveKit). Only 443/80
# are forwarded on the router, so the actual call media (not signaling) has
# no way through when direct UDP/TCP to the home IP doesn't work — same
# LAN without hairpin NAT, a VPN on either device, school/corporate wifi
# blocking UDP, etc. docker-compose.yml defaults these to the Open Relay
# Project's free, public, no-signup static-auth TURN host/secret (same
# values documented for self-hosted Matrix/Synapse — works with nothing
# set here at all). Only set these if you want a private relay instead
# (e.g. a paid/dynamic-credential provider) — they override the default.
TURN_RELAY_HOST=
TURN_RELAY_SECRET=

# Feature flags (keep off in production unless intentional)
ENABLE_ADMIN_KEY_HEADER=0
ENABLE_CLIENT_CHESS_REWARDS=0
APP_DEBUG_LOGS=0

# DEV ONLY — never set in production. Requires NODE_ENV != production to do
# anything at all. GOD_MODE=1 auto-logs in every visitor (even unauthenticated
# ones) as the admin@mitch.pro dev account with full owner/admin privileges —
# no login step needed. DEV_TEST_ACCESS=1 is the softer version: it only adds
# a "Test Mitch.pro" one-click login button on /enroll/ for localhost.
GOD_MODE=0
DEV_TEST_ACCESS=0

# VM Feature Configuration
HIDE_VM_FEATURES=0
PVE_LXC_TEMPLATE=local:vztmpl/debian-12-standard_12.12-1_amd64.tar.zst
PROXMOX_HOST=192.168.100.1
PROXMOX_PORT=8006
PROXMOX_NODE=tartarus
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_VERIFY_TLS=true
PROXMOX_TLS_SERVERNAME=mitch.pro
PROXMOX_DESKTOP_TEMPLATES=9010

# BYO-OS (custom ISO VMs). Storage IDs below must already exist in Proxmox
# and have the matching content type enabled — ISO storage needs "iso",
# VM storage needs "images". Defaults match a stock Proxmox install;
# only set these if this host's storage pool names differ.
PROXMOX_ISO_STORAGE=local
PROXMOX_VM_STORAGE=local-lvm
PROXMOX_VM_BRIDGE=vmbr0

# Internal services
BLOOKET_BOT_HOST=blooket-bot
SSH_GATEWAY_URL=ws://ssh-gateway:6820

# Analytics (optional)
GOOGLE_ANALYTICS_ID=
